{
  "name": "dsh-pappers-hall",
  "version": "0.18.3",
  "private": true,
  "description": "Pappers-Hall: a native DSH paper center with library, reader, annotations, figure search and conversation references.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs",
    "client.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build:client": "node client/build.mjs",
    "setup:embedding": "bash scripts/setup-embedding.sh"
  }
}
