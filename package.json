{
  "name": "dsh-pappers-hall",
  "version": "0.24.18",
  "description": "Pappers-Hall: a native DSH paper center with library, PDF reader, notes, annotations, figures and conversation references.",
  "license": "MIT",
  "author": "Pappers-Hall contributors",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/preview.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "client.js",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "papers",
    "pdf",
    "research",
    "notes",
    "annotations",
    "citations"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "node client/build.mjs",
    "build:client": "node client/build.mjs",
    "test:host": "node host/selftest.mjs",
    "test:notes": "node test/notes.mjs",
    "test:ui": "node test/ui-contract.mjs",
    "verify": "node scripts/verify-release.mjs",
    "prepack": "npm run build:client",
    "test:api": "node test/api-contract.mjs",
    "test:i18n": "node test/i18n-contract.mjs",
    "test:agent": "node test/note-agent.mjs",
    "test:rich": "node test/note-rich.mjs",
    "test:figures": "node test/figures-crop.mjs",
    "test:bridge": "node test/note-context.mjs"
  },
  "packageManager": "npm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuZhou0311/dsh-pappers-hall.git"
  },
  "homepage": "https://github.com/YuZhou0311/dsh-pappers-hall#readme",
  "bugs": {
    "url": "https://github.com/YuZhou0311/dsh-pappers-hall/issues"
  }
}
